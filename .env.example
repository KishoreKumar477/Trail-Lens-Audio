# Local vision uses Ollama's quantized Gemma 3 4B model (about 3.3 GB).
# Install it once with: ollama pull gemma3:4b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
# Free, local neural narration. Kokoro downloads its small voice model on first use.
TTS_PROVIDER=kokoro
KOKORO_VOICE=af_heart
KOKORO_SPEED=0.84
# MONGO_URI=mongodb+srv://...
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=...
